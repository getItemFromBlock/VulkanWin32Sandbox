// C4 speeds for each finetune value (mikIT/PT spec).  Index 0..7 = positive
// finetune (slightly higher pitch), index 8..15 = negative finetune (lower).
// In sample data we store finetune as a SIGNED -8..7 int — convert via &0xF.
const float c4speeds[16] = float[](
    8363.0, 8413.0, 8463.0, 8529.0, 8581.0, 8651.0, 8723.0, 8757.0,
    7895.0, 7941.0, 7985.0, 8046.0, 8107.0, 8169.0, 8232.0, 8280.0
);
float periodToFreq(int period) {
    // Default (finetune=0): 7093789.2 / (period × 2) ≈ 3546894.6/period.  Use
    // periodToFreqFt below when finetune matters.
    return period > 0 ? 7093789.2 / (float(period) * 2.0) : 0.0;
}
float periodToFreqFt(int period, int finetune) {
    // (c4 * 428) / period — matches HTML's pitch table exactly.
    if (period <= 0) return 0.0;
    int idx = finetune & 0xF;  // -1 (signed) → 0xF, etc.
    return (c4speeds[idx] * 428.0) / float(period);
}

// ═══ Chunked ivec4 fetchers ════════════════════════════════════════════════

// Fetch a byte from any chunked byte array (MSB-first within each int32).
// Each ivec4 holds 16 bytes: .x = bytes 0-3, .y = 4-7, .z = 8-11, .w = 12-15
// Within each int: byte 0 = MSB, byte 3 = LSB.

int _extractByte(ivec4 v, int byteInIvec4) {
    int intIdx = byteInIvec4 >> 2;
    int byteInInt = byteInIvec4 & 3;
    int packed = intIdx==0 ? v.x : intIdx==1 ? v.y : intIdx==2 ? v.z : v.w;
    int shift = 24 - byteInInt * 8;
    return (packed >> shift) & 0xFF;
}

// ── Dictionary byte fetch (byteIdx in [0, DICT_NOTES*4)) ──────────────────
int fetchDictByte(int byteIdx) {
    int ivec4Idx = byteIdx >> 4;
    int byteInIvec4 = byteIdx & 15;
    ivec4 v = patDict0[ivec4Idx];
    return _extractByte(v, byteInIvec4);
}

// ── Bitmap byte fetch ─────────────────────────────────────────────────────
int fetchBitmapByte(int byteIdx) {
    int ivec4Idx = byteIdx >> 4;
    int byteInIvec4 = byteIdx & 15;
    ivec4 v = patBitmap0[ivec4Idx];
    return _extractByte(v, byteInIvec4);
}

// ── Index stream byte fetch (chunked if needed) ──────────────────────────
int fetchIdxByte(int byteIdx) {
    int ivec4Idx = byteIdx >> 4;
    int byteInIvec4 = byteIdx & 15;
    int chunkIdx = ivec4Idx / 512;
    int localIvec4 = ivec4Idx % 512;
    ivec4 v = ivec4(0);
    if (chunkIdx == 0) v = patIdx0[localIvec4];
    else if (chunkIdx == 1) v = patIdx1[localIvec4];
    return _extractByte(v, byteInIvec4);
}

// ── Row-seek nibble byte fetch ───────────────────────────────────────────
int fetchRowSeekByte(int byteIdx) {
    int ivec4Idx = byteIdx >> 4;
    int byteInIvec4 = byteIdx & 15;
    ivec4 v = patRowSeek0[ivec4Idx];
    return _extractByte(v, byteInIvec4);
}

// ── VQ code stream byte fetch (chunked) ──────────────────────────────────
int fetchCodesByte(int byteIdx) {
    int ivec4Idx = byteIdx >> 4;
    int byteInIvec4 = byteIdx & 15;
    int chunkIdx = ivec4Idx / 512;
    int localIvec4 = ivec4Idx % 512;
    ivec4 v = ivec4(0);
    if (chunkIdx == 0) v = vqCodes0[localIvec4];
    else if (chunkIdx == 1) v = vqCodes1[localIvec4];
    else if (chunkIdx == 2) v = vqCodes2[localIvec4];
    else if (chunkIdx == 3) v = vqCodes3[localIvec4];
    else if (chunkIdx == 4) v = vqCodes4[localIvec4];
    else if (chunkIdx == 5) v = vqCodes5[localIvec4];
    else if (chunkIdx == 6) v = vqCodes6[localIvec4];
    else if (chunkIdx == 7) v = vqCodes7[localIvec4];
    else if (chunkIdx == 8) v = vqCodes8[localIvec4];
    else if (chunkIdx == 9) v = vqCodes9[localIvec4];
    else if (chunkIdx == 10) v = vqCodes10[localIvec4];
    return _extractByte(v, byteInIvec4);
}

// ── VQ codebook byte fetch (small, fits in 1 chunk usually) ──────────────
int fetchCodebookByte(int byteIdx) {
    int ivec4Idx = byteIdx >> 4;
    int byteInIvec4 = byteIdx & 15;
    int chunkIdx = ivec4Idx / 512;
    int localIvec4 = ivec4Idx % 512;
    ivec4 v = ivec4(0);
    if (chunkIdx == 0) v = vqCodebook0[localIvec4];
    return _extractByte(v, byteInIvec4);
}

// ═══ Pattern decoder: bitmap + dictionary + row seek ═══════════════════════

struct Note { int instrument, period, effect, param; };

// Popcount for 4-bit nibble (0..15 → 0..4)
int popcount4(int x) {
    x = (x & 0x5) + ((x >> 1) & 0x5);
    return (x & 0x3) + ((x >> 2) & 0x3);
}

// Reconstruct cumulative non-empty count up to start of `row` — O(1).
// Row seek table holds 16-bit LE prefix sums: 2 bytes per row.
int rowSeekCum(int targetRow) {
    int byteIdx = targetRow * 2;
    int lo = fetchRowSeekByte(byteIdx);
    int hi = fetchRowSeekByte(byteIdx + 1);
    return lo | (hi << 8);
}

Note emptyNote() { Note n; n.instrument=0; n.period=0; n.effect=0; n.param=0; return n; }

Note getNote(int songPos, int row, int channel) {
    int pat = songPositions[songPos];
    int rowGlobal = pat * 64 + row;
    int noteIdx   = rowGlobal * 4 + channel;

    // 1) Bitmap check
    int bmByte = fetchBitmapByte(noteIdx >> 3);
    int bit = (bmByte >> (noteIdx & 7)) & 1;
    if (bit == 0) return emptyNote();

    // 2) Count non-empty notes before this position
    //    = cumulative up to rowGlobal + popcount of bitmap nibble within this row
    int rank = rowSeekCum(rowGlobal);
    // This row's 4 bits span channels 0..3 → take channels [0..channel-1]
    int rowBitmapStart = rowGlobal * 4;
    // The 4 bits of this row may span 1 byte (if aligned) or 2.
    int byte0Idx = rowBitmapStart >> 3;
    int shift    = rowBitmapStart & 7;
    int byte0 = fetchBitmapByte(byte0Idx);
    int byte1 = fetchBitmapByte(byte0Idx + 1);
    int rowBits = ((byte0 >> shift) | (byte1 << (8 - shift))) & 0xF;
    int mask = (1 << channel) - 1;
    rank += popcount4(rowBits & mask);

    // 3) Look up index and fetch note from dictionary
    int dictIdx;
#if IDX_BYTES_PER == 1
    dictIdx = fetchIdxByte(rank);
#else
    int lo = fetchIdxByte(rank * 2);
    int hi = fetchIdxByte(rank * 2 + 1);
    dictIdx = lo | (hi << 8);
#endif
    int b0 = fetchDictByte(dictIdx * 4 + 0);
    int b1 = fetchDictByte(dictIdx * 4 + 1);
    int b2 = fetchDictByte(dictIdx * 4 + 2);
    int b3 = fetchDictByte(dictIdx * 4 + 3);

    Note n;
    n.instrument = (b0 & 0xF0) | ((b2 >> 4) & 0x0F);
    n.period     = ((b0 & 0x0F) << 8) | b1;
    n.effect     = b2 & 0x0F;
    n.param      = b3;
    return n;
}

// ═══ Sample decoder: 2-stage RVQ ×1 AA-downsampled (per-sample DS) ══
// 15-bit codes packed LSB-first: [8-bit code1][7-bit code2]
// periodToFreq = 7093789.2/(period*2) — per-sample DS via SampleInfo.bwFactor
#define RVQ_BITS     15
#define RVQ_BITS_1   8
#define RVQ_K1       256
#define RVQ_K2       128
#define RVQ_VEC_DIM  8
#define RVQ_CB2_BYTE (256 * 8)
#define RVQ_MASK1    255
#define RVQ_MASK2    127

void _getRVQCodes(int vecIdx, out int code1, out int code2) {
    int bitPos  = vecIdx * RVQ_BITS;
    int bytePos = bitPos >> 3;
    int shift   = bitPos & 7;
    int b0 = fetchCodesByte(bytePos);
    int b1 = fetchCodesByte(bytePos + 1);
    int b2 = fetchCodesByte(bytePos + 2);
    int b3 = fetchCodesByte(bytePos + 3);
    int combined = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    int raw = (combined >> shift) & ((1 << RVQ_BITS) - 1);
    code1 = raw & RVQ_MASK1;
#ifdef RVQ_NO_STAGE2
    code2 = 0;
#else
    code2 = (raw >> RVQ_BITS_1) & RVQ_MASK2;
#endif
}

float getSample(int sampleIdx) {
    if (sampleIdx < 0 || sampleIdx >= TOTAL_SAMPLES) return 0.0;
    int vecIdx = sampleIdx / RVQ_VEC_DIM;
    int lane   = sampleIdx - vecIdx * RVQ_VEC_DIM;
    // Inline RVQ decode (avoids out-parameter stack allocation)
    int _bp = vecIdx * RVQ_BITS, _by = _bp >> 3, _sh = _bp & 7;
    int _raw = (fetchCodesByte(_by) | (fetchCodesByte(_by+1)<<8) |
                (fetchCodesByte(_by+2)<<16) | (fetchCodesByte(_by+3)<<24));
    _raw = (_raw >> _sh) & ((1 << RVQ_BITS) - 1);
    int code1 = _raw & RVQ_MASK1;
    int ub1 = fetchCodebookByte(code1 * RVQ_VEC_DIM + lane);
    int s1  = ub1 < 128 ? ub1 : ub1 - 256;
#ifdef RVQ_NO_STAGE2
    return float(s1) / 128.0;
#else
    int code2 = (_raw >> RVQ_BITS_1) & RVQ_MASK2;
    int ub2 = fetchCodebookByte(RVQ_CB2_BYTE + code2 * RVQ_VEC_DIM + lane);
    int s2  = ub2 < 128 ? ub2 : ub2 - 256;
    return float(s1 + s2) / 128.0;
#endif
}

// ── Position calculation (Fxx-aware via rowStartTick) ────────────────────
struct Position { int songPos, pattern, row; float tick, rowTime; };

// Fetch 16-bit LE value at row index into rowStartTick
int fetchTick(int rowIdx) {
    int byteIdx = rowIdx * 2;
    int chunkIdx  = byteIdx >> 6;
    int byteIn16  = byteIdx & 63;
    int lo = _extractByte(rowStartTick0[(chunkIdx<<2)+(byteIn16>>4)], byteIn16 & 15);
    // next byte
    int byteIdx2 = byteIdx + 1;
    int chunkIdx2 = byteIdx2 >> 6;
    int byteIn16_2 = byteIdx2 & 63;
    int hi = _extractByte(rowStartTick0[(chunkIdx2<<2)+(byteIn16_2>>4)], byteIn16_2 & 15);
    return lo | (hi << 8);
}

Position getPosition(float time) {
    Position pos;
    float songDuration = float(TOTAL_TICKS) / TICKS_PER_SEC;
    float loopedTime = mod(time, songDuration);
    float totalTickF = loopedTime * TICKS_PER_SEC;

    // Binary search rowStartTick for the current row
    int lo = 0, hi = NUM_SONG_ROWS;
    for (int _bs = 0; _bs < 12; _bs++) {  // log2(1920+) ≈ 11
        if (lo >= hi - 1) break;
        int mid = (lo + hi) >> 1;
        if (float(fetchTick(mid)) <= totalTickF) lo = mid;
        else hi = mid;
    }
    int globalRow = lo;
    if (globalRow >= NUM_SONG_ROWS) globalRow = NUM_SONG_ROWS - 1;

    // Find songPos via linear search over patTickOffset (SONG_LENGTH ≤ 128, fast enough)
    int sp = SONG_LENGTH - 1;
    for (int _i = 0; _i < SONG_LENGTH - 1; _i++) {
        if (patTickOffset[_i + 1] > globalRow) { sp = _i; break; }
    }
    pos.songPos = sp;
    pos.pattern = songPositions[sp];
    pos.row     = globalRow - patTickOffset[sp];

    int rowTick    = fetchTick(globalRow);
    int nextTick   = fetchTick(globalRow + 1);
    int rowSpeed   = nextTick - rowTick;
    pos.tick       = totalTickF - float(rowTick);
    pos.rowTime    = float(rowSpeed) / TICKS_PER_SEC;
    return pos;
}

// 4-point cubic B-spline interpolation.
// B-spline is APPROXIMATING (smooths through sample points) rather than
// INTERPOLATING (passing exactly through them), giving inherent low-pass
// character that reduces high-frequency quantization noise.
float getSampleF(int base, float fpos, int smpLen, int loopStart, int loopLen) {
    int i = int(fpos);
    float t = fpos - float(i);
    float p1 = getSample(base + i);
    float p2 = getSample(base + min(i + 1, smpLen + 15));
    return mix(p1, p2, t);
}

// vibTab is declared as a global const float[32] near the top of Common
// (right after periodTable). Don't redeclare it here.

float getChannelOutput(int ch, float time, Position pos, float rowTime) {

    // Step 1: find most-recently-triggered note on this channel.
    // PT semantics — a "trigger" is something that starts the sample at pos 0:
    //   • Full row (instrument + period)              — retrigger
    //   • Period-only row (no inst, no effect 3/5)    — retrigger, inherit instrument
    //   • Period-only with effect 3/5                 — slide target only, no retrigger
    //   • Full row with effect 3/5                    — slide target only, no retrigger
    //   • Empty / instrument-only                     — continue prior note
    Note _curRow = getNote(pos.songPos, pos.row, ch);
    Note trigNote = _curRow;
    int  trigRow  = pos.row;
    int  trigPat  = pos.songPos;
    int  toneSlideTarget = 0;  // when set, this row carries a 3xx/5xx slide target
    bool _curIsTonePorta = ((_curRow.effect == 0x3 || _curRow.effect == 0x5) &&
                            _curRow.period > 0);
    bool _curIsRetrig    = (_curRow.period > 0 && !_curIsTonePorta);  // any period without 3/5 retriggers
    bool _curHasInst     = (_curRow.instrument > 0);

    if (_curIsTonePorta) {
        // Slide target — find prior REAL trigger for sample/period context
        toneSlideTarget = _curRow.period;
        int sR = pos.row, sP = pos.songPos;
        for (int lb = 1; lb < 128; lb++) {
            sR--;
            if (sR < 0) {
                if (sP > 0) {
                    sP--;
                    sR = patStartRow[sP] + (patRowOffset[sP+1] - patRowOffset[sP]) - 1;
                } else { break; }
            }
            Note prev = getNote(sP, sR, ch);
            bool prevIsToneTrig = ((prev.effect == 0x3 || prev.effect == 0x5) && prev.period > 0);
            // Real trigger: has period AND not a tone-porta target row
            if (prev.period > 0 && !prevIsToneTrig) {
                // Determine instrument: prefer prev.instrument, else scan further for context
                if (prev.instrument > 0) {
                    trigNote = prev; trigRow = sR; trigPat = sP;
                } else {
                    // Period-only row — find instrument context
                    Note real = prev;
                    int sR2 = sR, sP2 = sP;
                    for (int lb2 = 1; lb2 < 128; lb2++) {
                        sR2--;
                        if (sR2 < 0) {
                            if (sP2 > 0) { sP2--; sR2 = patStartRow[sP2] + (patRowOffset[sP2+1] - patRowOffset[sP2]) - 1; }
                            else break;
                        }
                        Note p2 = getNote(sP2, sR2, ch);
                        if (p2.instrument > 0) { real.instrument = p2.instrument; break; }
                    }
                    trigNote = real; trigRow = sR; trigPat = sP;
                }
                break;
            }
        }
    } else if (!_curIsRetrig) {
        // No period — continue prior note (or no audio if nothing prior).
        // _curHasInst with no period is a no-op for trigger purposes (PT quirk).
        int sR = pos.row, sP = pos.songPos;
        for (int lb = 1; lb < 128; lb++) {
            sR--;
            if (sR < 0) {
                if (sP > 0) {
                    sP--;
                    sR = patStartRow[sP] + (patRowOffset[sP+1] - patRowOffset[sP]) - 1;
                } else { break; }
            }
            Note prev = getNote(sP, sR, ch);
            bool prevIsToneTrig = ((prev.effect == 0x3 || prev.effect == 0x5) && prev.period > 0);
            if (prev.period > 0 && !prevIsToneTrig) {
                if (prev.instrument > 0) {
                    trigNote = prev; trigRow = sR; trigPat = sP;
                } else {
                    Note real = prev;
                    int sR2 = sR, sP2 = sP;
                    for (int lb2 = 1; lb2 < 128; lb2++) {
                        sR2--;
                        if (sR2 < 0) {
                            if (sP2 > 0) { sP2--; sR2 = patStartRow[sP2] + (patRowOffset[sP2+1] - patRowOffset[sP2]) - 1; }
                            else break;
                        }
                        Note p2 = getNote(sP2, sR2, ch);
                        if (p2.instrument > 0) { real.instrument = p2.instrument; break; }
                    }
                    trigNote = real; trigRow = sR; trigPat = sP;
                }
                break;
            }
        }
    } else if (_curIsRetrig && !_curHasInst) {
        // Period-only retrigger — find instrument context (sample inherited from prior trigger)
        int sR = pos.row, sP = pos.songPos;
        for (int lb = 1; lb < 128; lb++) {
            sR--;
            if (sR < 0) {
                if (sP > 0) {
                    sP--;
                    sR = patStartRow[sP] + (patRowOffset[sP+1] - patRowOffset[sP]) - 1;
                } else { break; }
            }
            Note prev = getNote(sP, sR, ch);
            if (prev.instrument > 0) {
                trigNote.instrument = prev.instrument;
                break;
            }
        }
        // trigPat/trigRow stay at current row — this IS a retrigger
    }
    // else: full trigger (period + instrument, no 3/5) — trigNote already correct

    if (trigNote.instrument <= 0 || trigNote.instrument > 31 || trigNote.period <= 0)
        return 0.0;

    SampleInfo smp = samples[trigNote.instrument - 1];
    if (smp.len == 0) return 0.0;

    // Tick-based elapsed: inline GR computation, skip named intermediates
    float elapsed = (float(fetchTick(patTickOffset[pos.songPos]+(pos.row-patStartRow[pos.songPos])))
                     + pos.tick
                     - float(fetchTick(patTickOffset[trigPat]+(trigRow-patStartRow[trigPat]))))
                    / TICKS_PER_SEC;
    if (elapsed < 0.0) return 0.0;

    int _pct = int(pos.tick);
    Note _pcr = getNote(pos.songPos, pos.row, ch);

    // ── Combined forward scan: rebuild pitch AND volume from trigger to current ──
    float effectivePeriod = float(trigNote.period);
    float targetPeriod    = float(trigNote.period);
    int   volume          = smp.volume;

    // Tone-porta trigger row: this row carries a 3xx/5xx slide target.
    // effectivePeriod stays at the previous trigger's period (already set above
    // from trigNote.period); slide accumulates toward toneSlideTarget over rows.
    if (toneSlideTarget > 0) {
        targetPeriod = float(toneSlideTarget);
    }

    // Apply trigger-row effects: Cxx (set vol), Axx/6xx (vol slide partial/full),
    // EAx (fine vol up — instant), EBx (fine vol down — instant), 5xx (tone+vol slide).
    if (trigNote.effect == 0xC) {
        volume = min(trigNote.param, 64);
    } else if (trigNote.effect == 0xE) {
        // Extended effects: EAx fine vol up, EBx fine vol down (instant on tick 0)
        int _es = (trigNote.param >> 4) & 0xF;
        int _ev =  trigNote.param       & 0xF;
        if (_es == 0xA)      volume = clamp(volume + _ev, 0, 64);
        else if (_es == 0xB) volume = clamp(volume - _ev, 0, 64);
    } else if (trigNote.effect == 0xA || trigNote.effect == 0x6 || trigNote.effect == 0x5) {
        // 0x5 = tone+vol slide: pitch handled by 0x3-equivalent block, vol param same as 0xA
        int _su = (trigNote.param>>4)&0xF, _sd = trigNote.param&0xF;
        int _step = (_su>0) ? _su : -_sd;
        if (trigPat == pos.songPos && trigRow == pos.row) {
            volume = clamp(volume + _step * _pct, 0, 64);
        } else {
            int _ts = fetchTick(patTickOffset[trigPat]+(trigRow-patStartRow[trigPat])+1)
                    - fetchTick(patTickOffset[trigPat]+(trigRow-patStartRow[trigPat]));
            volume = clamp(volume + _step * (_ts-1), 0, 64);
        }
    }

    // ── 0xED note delay: skip output for `param` ticks after trigger row ──
    // The note doesn't actually start until tick `param` of the trigger row.
    // Earlier than that → return silence; effective elapsed is reduced.
    int _noteDelayTicks = 0;
    if (trigNote.effect == 0xE && ((trigNote.param >> 4) & 0xF) == 0xD) {
        _noteDelayTicks = trigNote.param & 0xF;
        if (trigPat == pos.songPos && trigRow == pos.row && _pct < _noteDelayTicks)
            return 0.0;  // before delayed trigger
        // After delay: subtract delay ticks from elapsed so the note starts at fresh t=0
        elapsed = max(0.0, elapsed - float(_noteDelayTicks) / TICKS_PER_SEC);
    }

    // ── 0x9xx sample offset (trigger row only): start at param * 256 in sample data ──
    int _sampleOffset = 0;
    if (trigNote.effect == 0x9 && trigNote.param > 0) {
        _sampleOffset = trigNote.param * 256;
    }

    // ── Trigger row's pitch slide effects (1xx/2xx) ──
    // If the trigger row carried 1xx (porta up) or 2xx (porta down), those
    // slides happen on ticks 1..(speed-1) of the trigger row.  When pos is
    // PAST the trigger row, all (speed-1) of those ticks have completed.
    // When pos is on the trigger row itself, the "Current row partial pitch
    // effect" block below handles it — don't double-apply here.
    if ((trigPat != pos.songPos || trigRow != pos.row) &&
        (trigNote.effect == 0x1 || trigNote.effect == 0x2) && trigNote.param > 0) {
        int _trSgr = patTickOffset[trigPat] + (trigRow - patStartRow[trigPat]);
        int _trSpd = fetchTick(_trSgr + 1) - fetchTick(_trSgr);
        int _trTicks = _trSpd - 1;  // all post-tick-0 ticks of trigger row
        if (trigNote.effect == 0x1)
            effectivePeriod = max(113.0, effectivePeriod - float(trigNote.param * _trTicks));
        else  // 0x2
            effectivePeriod = min(856.0, effectivePeriod + float(trigNote.param * _trTicks));
    }

    // Track last tone-porta rate (for effect 5 to inherit).  Initialized from
    // trigger row's 3xx param; updated by forward scan as it walks past 3xx rows.
    int _lastTPRate = 0;
    if (trigNote.effect == 0x3 && trigNote.param > 0) _lastTPRate = trigNote.param;

    // Forward scan: rows STRICTLY between trigger and current
    if (trigPat != pos.songPos || trigRow != pos.row) {
        int _fp = trigPat, _fr = trigRow + 1;
        if (_fr >= patStartRow[_fp] + (patRowOffset[_fp+1] - patRowOffset[_fp])) {
            _fp++; _fr = (_fp < SONG_LENGTH) ? patStartRow[_fp] : 0;
        }
        for (int _fi = 0; _fi < 128; _fi++) {
            if (_fp > pos.songPos || (_fp == pos.songPos && _fr >= pos.row)) break;
            if (_fp >= SONG_LENGTH) break;
            if (_fr >= patStartRow[_fp] + (patRowOffset[_fp+1] - patRowOffset[_fp])) {
                _fp++; _fr = (_fp < SONG_LENGTH) ? patStartRow[_fp] : 0;
                continue;
            }
            Note _fn = getNote(_fp, _fr, ch);
            // ANY row with period > 0 and effect not 3/5 is a real RETRIGGER
            // that ends the forward scan (next getChannelOutput call handles it).
            bool _fnIsToneTrig = ((_fn.effect == 0x3 || _fn.effect == 0x5) && _fn.period > 0);
            bool _fnIsRetrig   = (_fn.period > 0 && !_fnIsToneTrig);
            if (_fnIsRetrig) break;
            // Tone-porta target: pitch slides toward _fn.period over remaining rows.
            if (_fnIsToneTrig) {
                targetPeriod = float(_fn.period);
            }
            // Track last 3xx rate for effect 5 to inherit
            if (_fn.effect == 0x3 && _fn.param > 0) _lastTPRate = _fn.param;

            int _sgr   = patTickOffset[_fp] + (_fr - patStartRow[_fp]);
            int _full  = fetchTick(_sgr + 1) - fetchTick(_sgr) - 1;  // ticks 1..speed-1

            // Pitch effects
            if (_fn.effect == 0x1)
                effectivePeriod = max(113.0, effectivePeriod - float(_fn.param * _full));
            else if (_fn.effect == 0x2)
                effectivePeriod = min(856.0, effectivePeriod + float(_fn.param * _full));
            else if (_fn.effect == 0x3) {
                // Tone porta — uses its own param as slide rate
                if (effectivePeriod < targetPeriod)
                    effectivePeriod = min(targetPeriod, effectivePeriod + float(_fn.param * _full));
                else if (effectivePeriod > targetPeriod)
                    effectivePeriod = max(targetPeriod, effectivePeriod - float(_fn.param * _full));
            }
            else if (_fn.effect == 0x5) {
                // Continue tone porta — uses LAST 3xx rate (not _fn.param!)
                if (_lastTPRate > 0) {
                    if (effectivePeriod < targetPeriod)
                        effectivePeriod = min(targetPeriod, effectivePeriod + float(_lastTPRate * _full));
                    else if (effectivePeriod > targetPeriod)
                        effectivePeriod = max(targetPeriod, effectivePeriod - float(_lastTPRate * _full));
                }
            }
            // Volume effects
            else if (_fn.effect == 0xC)
                volume = min(_fn.param, 64);
            else if (_fn.effect == 0xA || _fn.effect == 0x6) {
                int _vu = (_fn.param>>4)&0xF, _vd = _fn.param&0xF;
                volume = clamp(volume + (_vu>0?_vu:-_vd) * _full, 0, 64);
            }
            else if (_fn.effect == 0xE) {
                // EAx fine vol up, EBx fine vol down (instant per row)
                int _es = (_fn.param >> 4) & 0xF;
                int _ev =  _fn.param       & 0xF;
                if (_es == 0xA)      volume = clamp(volume + _ev, 0, 64);
                else if (_es == 0xB) volume = clamp(volume - _ev, 0, 64);
            }
            // 0x5 also applies the volume slide portion (high nibble = up, low = down)
            if (_fn.effect == 0x5) {
                int _vu = (_fn.param>>4)&0xF, _vd = _fn.param&0xF;
                volume = clamp(volume + (_vu>0?_vu:-_vd) * _full, 0, 64);
            }
            _fr++;
            // Advance to next song position when we've exhausted this pattern's rows
            if (_fr >= patStartRow[_fp] + (patRowOffset[_fp+1] - patRowOffset[_fp])) {
                _fp++;
                _fr = (_fp < SONG_LENGTH) ? patStartRow[_fp] : 0;
            }
        }

        // Current row partial (non-trigger row only — trigger handled above)
        if (_pcr.instrument <= 0 && _pcr.period <= 0) {
            if (_pcr.effect == 0xC)
                volume = min(_pcr.param, 64);
            else if (_pcr.effect == 0xA || _pcr.effect == 0x6) {
                int _vu = (_pcr.param>>4)&0xF, _vd = _pcr.param&0xF;
                volume = clamp(volume + (_vu>0?_vu:-_vd) * _pct, 0, 64);
            }
            else if (_pcr.effect == 0xE) {
                int _es = (_pcr.param >> 4) & 0xF;
                int _ev =  _pcr.param       & 0xF;
                if (_es == 0xA)      volume = clamp(volume + _ev, 0, 64);
                else if (_es == 0xB) volume = clamp(volume - _ev, 0, 64);
            }
            if (_pcr.effect == 0x5) {
                // 0x5 vol-slide portion on current row
                int _vu = (_pcr.param>>4)&0xF, _vd = _pcr.param&0xF;
                volume = clamp(volume + (_vu>0?_vu:-_vd) * _pct, 0, 64);
            }
        }
    }

    // Current row partial pitch effect (applies even on trigger row).
    // Use continuous pos.tick — but cap it at (speed-1) so the contribution
    // at the last sample of this row exactly matches what the forward scan
    // will use for this row once it becomes a "completed" row.  Without the
    // cap, pos.tick approaches `speed` at the row boundary while the forward
    // scan uses `speed-1`, producing a ~1-tick backward period jump = click.
    // Only pay the fetchTick cost when a pitch effect is actually present.
    // Current row partial pitch effect (applies on trigger row OR continuation row).
    // For 1xx/2xx: always applies on current row.
    // For 3xx/5xx: applies whenever current row carries the effect — both
    //   continuation rows (period==0) AND tone-porta target rows (period>0).
    //   The targetPeriod was already set above (either from trigNote or
    //   toneSlideTarget); this block does the per-tick accumulation toward it.
    if (_pcr.effect == 0x1 || _pcr.effect == 0x2 ||
        _pcr.effect == 0x3 || _pcr.effect == 0x5) {
        int _sgr_cur = patTickOffset[pos.songPos] + (pos.row - patStartRow[pos.songPos]);
        float _ptf = min(pos.tick,
                         float(fetchTick(_sgr_cur + 1) - fetchTick(_sgr_cur) - 1));
        if (_pcr.effect == 0x1)
            effectivePeriod = max(113.0, effectivePeriod - float(_pcr.param) * _ptf);
        else if (_pcr.effect == 0x2)
            effectivePeriod = min(856.0, effectivePeriod + float(_pcr.param) * _ptf);
        else if (_pcr.effect == 0x3) {
            // Tone porta — uses its own param as slide rate
            if (effectivePeriod < targetPeriod)
                effectivePeriod = min(targetPeriod, effectivePeriod + float(_pcr.param) * _ptf);
            else if (effectivePeriod > targetPeriod)
                effectivePeriod = max(targetPeriod, effectivePeriod - float(_pcr.param) * _ptf);
        }
        else {  // 0x5 — continue tone porta using last 3xx rate (param is vol-slide only)
            if (_lastTPRate > 0) {
                if (effectivePeriod < targetPeriod)
                    effectivePeriod = min(targetPeriod, effectivePeriod + float(_lastTPRate) * _ptf);
                else if (effectivePeriod > targetPeriod)
                    effectivePeriod = max(targetPeriod, effectivePeriod - float(_lastTPRate) * _ptf);
            }
        }
    }

    // Tremolo (Effect 0x7) — same waveform as vibrato but modulates VOLUME.
    // Uses same row-by-row historical tS/tD tracking as vibrato.
    {
        int _tS = 0, _tD = 0;
        int _trePos = 0;
        if (trigNote.effect == 0x7) {
            int _ns = (trigNote.param >> 4) & 0xF;
            int _nd =  trigNote.param       & 0xF;
            if (_ns > 0) _tS = _ns;
            if (_nd > 0) _tD = _nd;
        }
        if (trigPat == pos.songPos && trigRow == pos.row) {
            _trePos = int(pos.tick) * _tS;
        } else {
            int _trSgr = patTickOffset[trigPat] + (trigRow - patStartRow[trigPat]);
            int _trSpd = fetchTick(_trSgr + 1) - fetchTick(_trSgr);
            _trePos = (_trSpd - 1) * _tS;
            int _wp = trigPat, _wr = trigRow + 1;
            if (_wr >= patStartRow[_wp] + (patRowOffset[_wp+1] - patRowOffset[_wp])) {
                _wp++; _wr = (_wp < SONG_LENGTH) ? patStartRow[_wp] : 0;
            }
            for (int _wi = 0; _wi < 128; _wi++) {
                if (_wp > pos.songPos || (_wp == pos.songPos && _wr >= pos.row)) break;
                if (_wp >= SONG_LENGTH) break;
                if (_wr >= patStartRow[_wp] + (patRowOffset[_wp+1] - patRowOffset[_wp])) {
                    _wp++; _wr = (_wp < SONG_LENGTH) ? patStartRow[_wp] : 0;
                    continue;
                }
                Note _tn = getNote(_wp, _wr, ch);
                bool _tnIsTone = ((_tn.effect == 0x3 || _tn.effect == 0x5) && _tn.period > 0);
                if (_tn.period > 0 && !_tnIsTone) break;
                if (_tn.effect == 0x7 && _tn.param != 0) {
                    int _ns = (_tn.param >> 4) & 0xF;
                    int _nd =  _tn.param       & 0xF;
                    if (_ns > 0) _tS = _ns;
                    if (_nd > 0) _tD = _nd;
                }
                int _sgr = patTickOffset[_wp] + (_wr - patStartRow[_wp]);
                int _spd = fetchTick(_sgr + 1) - fetchTick(_sgr);
                _trePos += (_spd - 1) * _tS;
                _wr++;
            }
            // Update from current row if it carries tremolo
            if (_pcr.effect == 0x7 && _pcr.param != 0) {
                int _ns = (_pcr.param >> 4) & 0xF;
                int _nd =  _pcr.param       & 0xF;
                if (_ns > 0) _tS = _ns;
                if (_nd > 0) _tD = _nd;
            }
            _trePos += int(pos.tick) * _tS;
        }
        if (_tD > 0 && _tS > 0) {
            int _tP = _trePos & 63;
            float _tDelta = (vibTab[_tP & 31] * float(_tD)) / 64.0;
            volume = clamp(int(float(volume) + ((_tP < 32) ? _tDelta : -_tDelta)), 0, 64);
        }
    }

    // Arpeggio (Effect 0xy) — pymod's order is base→X(high)→Y(low)
    if (_pcr.effect == 0x0 && _pcr.param != 0) {
        int _arpStep = int(pos.tick) - int(pos.tick / 3.0) * 3;
        // effectivePeriod IS basePeriod here (no further modification before arp)
        if (_arpStep == 1)
            effectivePeriod = effectivePeriod * pow(2.0, -float((_pcr.param >> 4) & 0xF) / 12.0);
        else if (_arpStep == 2)
            effectivePeriod = effectivePeriod * pow(2.0, -float(_pcr.param & 0xF) / 12.0);
    }

    // Vibrato (Effect 4) — uses global vibTab.
    // Effect 4xx: param = (speed << 4) | depth.  Sets vS, vD.
    // Effect 6xx: continue vibrato (uses prior 4xx's vS/vD; its own param is
    //             vol-slide only — handled separately in volume code path).
    //
    // vibratoPos increments by vS on each NON-tick-0 (i.e., (speed-1) per row).
    // Walk from trigger to current, updating vS/vD ONLY on 4xx rows, and
    // accumulating (speed-1)*vS per completed row using historical vS.
    {
        int _vS = 0, _vD = 0;
        int _vibPos = 0;

        // Initialize vS/vD ONLY from trigger row's 0x4 (NOT 0x6 — its param is vol-slide)
        if (trigNote.effect == 0x4) {
            int _ns = (trigNote.param >> 4) & 0xF;
            int _nd =  trigNote.param       & 0xF;
            if (_ns > 0) _vS = _ns;
            if (_nd > 0) _vD = _nd;
        }

        if (trigPat == pos.songPos && trigRow == pos.row) {
            // On trigger row: vibrato has only had pos.tick increments
            _vibPos = int(pos.tick) * _vS;
        } else {
            // Trigger row contributes (speed-1) increments at trigger-row vS
            int _trSgr = patTickOffset[trigPat] + (trigRow - patStartRow[trigPat]);
            int _trSpd = fetchTick(_trSgr + 1) - fetchTick(_trSgr);
            // Vibrato keeps running on 0x6 rows too — accumulate (speed-1)*vS
            // even when this row was 0x6, using the inherited vS.
            bool _trigIsVibActive = (trigNote.effect == 0x4 || trigNote.effect == 0x6);
            _vibPos = _trigIsVibActive ? (_trSpd - 1) * _vS : 0;

            // Walk row-by-row from trigger+1 to current-1, updating vS/vD
            // on 0x4 rows, and accumulating per-row using historical vS.
            int _wp = trigPat, _wr = trigRow + 1;
            if (_wr >= patStartRow[_wp] + (patRowOffset[_wp+1] - patRowOffset[_wp])) {
                _wp++; _wr = (_wp < SONG_LENGTH) ? patStartRow[_wp] : 0;
            }
            for (int _wi = 0; _wi < 128; _wi++) {
                if (_wp > pos.songPos || (_wp == pos.songPos && _wr >= pos.row)) break;
                if (_wp >= SONG_LENGTH) break;
                if (_wr >= patStartRow[_wp] + (patRowOffset[_wp+1] - patRowOffset[_wp])) {
                    _wp++; _wr = (_wp < SONG_LENGTH) ? patStartRow[_wp] : 0;
                    continue;
                }
                Note _vn = getNote(_wp, _wr, ch);
                // Stop on retrigger
                bool _vnIsTone = ((_vn.effect == 0x3 || _vn.effect == 0x5) && _vn.period > 0);
                if (_vn.period > 0 && !_vnIsTone) break;
                // Update vS/vD ONLY on 0x4 rows (0x6 has vol-slide param, not vibrato)
                if (_vn.effect == 0x4 && _vn.param != 0) {
                    int _ns = (_vn.param >> 4) & 0xF;
                    int _nd =  _vn.param       & 0xF;
                    if (_ns > 0) _vS = _ns;
                    if (_nd > 0) _vD = _nd;
                }
                // Accumulate vibrato pos when row is 0x4 OR 0x6 (vibrato runs on both)
                if (_vn.effect == 0x4 || _vn.effect == 0x6) {
                    int _sgr = patTickOffset[_wp] + (_wr - patStartRow[_wp]);
                    int _spd = fetchTick(_sgr + 1) - fetchTick(_sgr);
                    _vibPos += (_spd - 1) * _vS;
                }
                _wr++;
            }

            // Update vS/vD from current row ONLY if 0x4
            if (_pcr.effect == 0x4 && _pcr.param != 0) {
                int _ns = (_pcr.param >> 4) & 0xF;
                int _nd =  _pcr.param       & 0xF;
                if (_ns > 0) _vS = _ns;
                if (_nd > 0) _vD = _nd;
            }
            // Current row partial: pos.tick increments at current-row vS
            // ONLY when current row has vibrato active (0x4 or 0x6)
            if (_pcr.effect == 0x4 || _pcr.effect == 0x6) {
                _vibPos += int(pos.tick) * _vS;
            }
        }

        if (_vD > 0 && _vS > 0) {
            int _vP = _vibPos & 63;
            float _vDelta = (vibTab[_vP & 31] * float(_vD)) / 128.0;
            effectivePeriod += (_vP < 32) ? _vDelta : -_vDelta;
        }
    }

    // Render sample
    // basePeriod = effectivePeriod WITHOUT vibrato/tremolo modulation.  Using the
    // modulated value for fSamplePos integration would multiply the modulation
    // amplitude by `elapsed`, producing a substantial buzz at vibrato rate
    // (e.g., flute on pat 1 ch0 at vec_dim=8).  The TRUE position-domain effect
    // of vibrato is the integral of the freq modulation, which is a tiny <1-
    // sample oscillation — safely negligible.
    float basePeriod = effectivePeriod;
    if (trigNote.effect == 0x4 || trigNote.effect == 0x6 || trigNote.effect == 0x7 ||
        _pcr.effect == 0x4 || _pcr.effect == 0x6 || _pcr.effect == 0x7) {
        basePeriod = (targetPeriod > 0.0) ? targetPeriod : float(trigNote.period);
    }
    float freq = periodToFreqFt(max(1, int(basePeriod)), smp.finetune);
    // Sample position:
    //   - If current row has active pitch slide (1xx/2xx/3xx), use log integral
    //     ∫C/P(t)dt ≈ C×T/ΔP × ln(P1/P0)  (assumes linear ramp; close enough)
    //   - Otherwise period is stable past trigger; simple elapsed×freq is exact.
    bool _slideActive = (_pcr.effect == 0x1 || _pcr.effect == 0x2 ||
                         _pcr.effect == 0x3 || _pcr.effect == 0x5);
    float fSamplePos;
    if (_slideActive) {
        float P0f = float(trigNote.period);
        float P1f = basePeriod;
        float dPf = P1f - P0f;
        if (abs(dPf) > 0.5 && elapsed > 1e-6) {
            // Log integral with finetune: substitute c4*428/2 for the constant C.
            float ftC = c4speeds[smp.finetune & 0xF] * 428.0 / float(smp.bwFactor);
            fSamplePos = ftC * elapsed / dPf * log(P1f / P0f);
        } else {
            fSamplePos = elapsed * freq / float(smp.bwFactor);
        }
    } else {
        fSamplePos = elapsed * freq / float(smp.bwFactor);
    }
    // 0x9xx sample offset: shift starting position (in compressed-domain samples)
    if (_sampleOffset > 0) {
        fSamplePos += float(_sampleOffset / max(1, smp.bwFactor));
    }

    if (smp.loopLen > 2) {
        if (fSamplePos >= float(smp.loopStart + smp.loopLen))
            fSamplePos = float(smp.loopStart) + mod(fSamplePos - float(smp.loopStart), float(smp.loopLen));
    } else if (fSamplePos >= float(smp.len)) {
        return 0.0;
    }
    if (fSamplePos < 0.0) return 0.0;

    // Sample value with proper end-fade (sample termination should not snap to 0)
    float s;
    if (smp.loopLen <= 2 && fSamplePos >= float(smp.len) - 1.0) {
        // Near end of non-looping sample: fade out over last sample to avoid click
        s = 0.0;
    } else {
        s = getSampleF(smp.start, fSamplePos, smp.len, smp.loopStart, smp.loopLen);
    }

    // ── Anti-click ramps ──
    // 1. Trigger ramp: 64-sample fade-in on every new note (mikIT fadecount).
    //    Volume goes 0→1 over first 64 output samples after trigger.
    float declick = clamp(elapsed * (44100.0 / 64.0), 0.0, 1.0);

    // 2. End-of-sample fade-out: 64-sample fade-out as fSamplePos approaches
    //    sample end (only for non-looping samples).  Prevents sudden silence.
    float endFade = 1.0;
    if (smp.loopLen <= 2) {
        float remaining = float(smp.len) - fSamplePos;
        if (remaining < 64.0) endFade = max(0.0, remaining / 64.0);
    }

    // 3. Loop crossfade: smooths any residual loopEnd→loopStart discontinuity.
    //    The encoder now embeds loop wrap context next to loopEnd so VQ
    //    quantization keeps the seam continuous, but a 16-sample crossfade
    //    catches any remaining mismatch.
    if (smp.loopLen > 2) {
        const float CROSSFADE_LEN = 16.0;
        float loopEnd = float(smp.loopStart + smp.loopLen);
        float distFromEnd = loopEnd - fSamplePos;
        if (distFromEnd > 0.0 && distFromEnd < CROSSFADE_LEN) {
            float wrapPos = float(smp.loopStart) + (CROSSFADE_LEN - distFromEnd);
            float wrapSample = getSampleF(smp.start, wrapPos, smp.len, smp.loopStart, smp.loopLen);
            float blend = (CROSSFADE_LEN - distFromEnd) / CROSSFADE_LEN;
            // Equal-power crossfade
            float w1 = cos(blend * 1.5707963);
            float w2 = sin(blend * 1.5707963);
            s = s * w1 + wrapSample * w2;
        }
    }

    return s * (float(volume) / 64.0) * declick * endFade;
}


