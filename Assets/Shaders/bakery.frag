/*

SID emulation created by Fredrik Hubinette & Tonny Espeset.

Feel free to use this shader in your own project as long as you aknowledge the authors.

Features:

    * Emulates the C64 SID chip fairly accurately and plays back audio from SID dumps
    * SID dumps stored as RLE compressed vec4 to minimize register usage, allowing fairly long songs
    * Prebaked ADSR & phase calculation to allow stateless calculation.
 
Tools:

    * Tonny made tools for dumping and compressing SID data.
    * I created my own tool for doing the compression.
    * Both tools are available upon request.

TODO:

    * Modulation, filtering and a few other SID emulation aspects is WIP, will affect accuracy on complex songs
    * This was all made from scratch with just basic prior knowledge of the SID chip. Needs further research and polishing


Sources:
    * Original SID Player: https://www.shadertoy.com/view/clGBRt
    * SID information: https://www.waitingforfriday.com/?p=661

*/


// Use a clock freqency of 985248Hz for PAL C64, 1022730Hz for NTSC C64.
const float Fclk = 985248.0; // Clock frequency in Hz (1.0 MHz)

int getSampleRaw(int index) {
      //Vec4 allows more data per register
      int block = (index / 16);
      ivec4 value = samples[block];
      int blockPosition = index % 16;

      // Determine which component of the ivec4 to access
      int component = blockPosition / 4;
      int shiftAmount = (3 - (blockPosition % 4))*8;
      return (value[component] >> shiftAmount) & 0xFF;
}



//RLE format: Negative opcode n means repeat the next byte -n+1 times, positive opcode means copy the n+1 next bytes 
int getSampleRLE(int start,int decompressedIndex) {
    int compressedIndex = start;
    int currentDecompressedIndex = 0;
    
    while (true) {
        int countByte = getSampleRaw(compressedIndex);
        compressedIndex++;

        if (countByte < 0x80) {
            // Non-repeating bytes
            if (currentDecompressedIndex + countByte >= decompressedIndex) {
                compressedIndex = compressedIndex + decompressedIndex - currentDecompressedIndex;
                break;
            }
            currentDecompressedIndex += countByte + 1;
            compressedIndex += countByte + 1;
        } else {
            // Repeating getSampleRaw
            int repeatCount = (0x100 - countByte)+1;
            if (currentDecompressedIndex + repeatCount > decompressedIndex) {
                break;
            }
            currentDecompressedIndex += repeatCount;
            compressedIndex++;
        }
    }
    return getSampleRaw(compressedIndex);
}

int get_block_index(int i) {
  ivec4 iv = block_index[i/4];
  return iv[i % 4];
}

int getSample2(int bank,int index) {
   int chunk = bank * BLOCKS_PER_BANK + index / BLOCK_SIZE;
   int ptr = get_block_index(chunk);
   int offset = (ptr & 0xff);
   ptr = ptr >> 8;
   return (getSampleRLE(ptr, index % BLOCK_SIZE) - offset) & 0xff;
}

struct Channel {
  int registers[7];
};


int freq(Channel c) { return (c.registers[1] << 8) + c.registers[0]; }
int pw(Channel c) { return (c.registers[3] << 8) + c.registers[1]; }
int ctrl(Channel c) { return c.registers[4]; }
int amp(Channel c) { return c.registers[5]; }
int phase(Channel c) { return c.registers[6]; }

// Define constants for waveform types based on their bit positions
const int TRIANGLE = 1 << 4;     // Triangle Wave (Bit 4)
const int SAWTOOTH = 1 << 5;     // Sawtooth Wave (Bit 5)
const int SQUARE_WAVE = 1 << 6;  // Square Wave (Bit 6)
const int NOISE = 1 << 7;        // Noise (Bit 7)

int waveform(Channel c) {
  int cr = ctrl(c);
  if ((cr & NOISE) != 0)       return NOISE;
  if ((cr & SQUARE_WAVE) != 0) return SQUARE_WAVE;
  if ((cr & SAWTOOTH) != 0)    return SAWTOOTH;
  if ((cr & TRIANGLE) != 0)    return TRIANGLE;

  return 0; // Silence, when none of the bits are set
}

struct Sid {
  Channel c[3];
};

#define REGS 21
int base_index;
Sid sids[PHASE_DECIMATION];

void set(int index, int reg, int value) {
  sids[index - base_index].c[reg / 7].registers[reg % 7] = value;
}

float phaseIncrement(int index, int channel) {
  float frequency = float(freq(sids[index - base_index].c[channel]));
  return mod(frequency * (Fclk / 16777216.0) / SAMPLE_RATE, 1.0);
}

float basePhase(int index, int channel) {
  return mod(phaseIncrement(index, channel) * float(index), 1.0);
}

void fixPhase(int index, int frame) {
  int I = (index / PHASE_DECIMATION) * PHASE_DECIMATION;
  if (I == index) return;
  for (int ch = 0; ch < 3; ch++) {
    int i = I;
    float P = float(sids[i - base_index].c[ch].registers[6]) / 256.0;
    P = mod(P + basePhase(i, ch) + 1.0 - basePhase(index, ch), 1.0);
    while (i < index) {
      P = mod(P + phaseIncrement(i, ch), 1.0);
      i++;
    }
    set(index, ch*7 + 6, int(P * 256.0));    
  }
}


void setup(int index, int frame) {
  base_index = index - PHASE_DECIMATION + 1;
  for (int i = max(0, base_index); i <= index + min(0, frame); i++) {
    for (int j = 0; j < REGS + min(0, frame); j++) {
      int p = i;
      if (j % 7 == 6) p /= PHASE_DECIMATION;
      set(i, j, getSample2(j, p));
    }
  }
  
  fixPhase(index, frame);
}



float getNoiseSamplesPerSecond(float frequency) {
    if (frequency == 0.0)
        return 0.0;
#if 1
    // Calculate the internal frequency (scaling based on the SID's clock frequency)
    float internalFreq = float(frequency) * (Fclk / float(0x10000));
    // Calculate and return the number of noise samples per second
    // The noise generator updates when the 23-bit right-shifted counter changes
   return Fclk / (pow(2.0, 23.0) / internalFreq);
#else
   return frequency * (Fclk / float(0x180000));
#endif
}

float rand(int seed) {
    int n = (seed << 13) ^ seed;
    int nn = (n * (n * n * 15731 + 789221) + 1376312589) & 0x7fffffff;
    float res = float(nn) / float(0x7fffffff);
    return res * 2.0 - 1.0;
}

float sidWaveform(Channel c, float time) {
    float frequency = float(freq(c));
    // Calculate the actual frequency (Fout) using the frequency number (Fn)
    float Fout = frequency * (Fclk / 16777216.0); // Convert Fn to Fout

    // Calculate the phase based on time in seconds
    // Phase increment per second is Fout, so phase increment per sample is Fout * time
    float phase = mod(float(phase(c))/256.0 + time * Fout, 1.0); // Normalized phase [0, 1)

    int waveform = waveform(c);
    
    // Generate the waveform based on the phase
    if (waveform == SAWTOOTH) {
        return phase * 2.0 - 1.0;
    }
    if (waveform == TRIANGLE) {
        return abs(phase * 2.0 - 1.0) * 2.0 - 1.0;
    }
    if (waveform == SQUARE_WAVE) {
        int pulseWidth=pw(c);
        float pulseWidthNormalized = float(pulseWidth) / 4095.0;
        pulseWidthNormalized=0.5;
        return phase < pulseWidthNormalized ? 1.0 : -1.0;
    }
    if (waveform == NOISE) {
        float samplesPerSecond=getNoiseSamplesPerSecond(frequency);
        return rand(int(time*samplesPerSecond));
    }
    return 0.0;
}

float getSample(Channel c, float time) {
  return sidWaveform(c, time) * float(amp(c)) / 255.0;
}

float getSample(Sid sid, float time) {
  float ret = 0.0;
  for (int i = 0; i < 3+min(0,int(time)); i++) {
    ret += getSample(sid.c[i], time);
  }
  return ret / 9.0;
}


// Main sound generation function<
vec2 mainSound(int frame, float time) {

    time=mod(time,PLAY_TIME);
    frame=frame % 1000;

    float sampleTime=SAMPLE_RATE*time;
    int sampleIndex = int(sampleTime);
    float s=sampleTime-float(sampleIndex);
    
    setup(sampleIndex, frame);

    float monoSound = getSample(sids[PHASE_DECIMATION - 1], time);

    return vec2(monoSound, monoSound);
}

layout(location = 0) out vec4 outColor;

const ivec2 size = ivec2(4096,2048);

void main()
{
	ivec2 c = ivec2(gl_FragCoord.xy);
	int samp = c.x + c.y * size.x;
	if (samp > 4096*16)
		samp = 0;
	float time = float(samp) / 44100.0;
    vec2 res = mainSound(samp, time);
	outColor = vec4(res, 0., 1.);
}