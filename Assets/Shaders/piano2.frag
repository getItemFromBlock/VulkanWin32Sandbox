vec2 play( float t )
{
    int ZERO = int(min(t,0.0));

    vec2 strings = vec2(0.0);

    float modeS[10];
    float modeC[10];
    for( int j=ZERO; j<NMODES; j++ ) { modeS[j]=0.0; modeC[j]=0.0; }

    int b = 0;
    for( int i=ZERO; i<kMusic.length(); i++ )
    {
        int dsk = kMusic[i];
        int d = (dsk>>20)&0xfff;
        int s = (dsk>> 8)&0xfff;
        int k = (dsk>> 0)&0x07f;
        b += d;

        const float tps = 940.0;
        float bt = float(b)/tps;
        float jit = mix(0.003, 0.001, smoothstep(55.0, 75.0, float(k)));
        bt += jit*sin(float(i)*56124.0);

        if( bt>t ) break;

        float tn = t - bt;
        if( tn>5.0 ) continue;

        float vPitch  = 0.45 + 0.40*smoothstep(48.0, 84.0, float(k));
        float vHuman  = 0.90 + 0.10*sin(float(i)*6731.0);
        float barPos  = mod(float(b), 2820.0)/2820.0;
        float accent  = 1.0 + 0.08*exp(-barPos*20.0);
        float v = clamp(vPitch*vHuman*accent, 0.30, 1.00);

        strings += pianoStrings(float(k), tn, float(s)/tps, v, ZERO);

        float bassBoost = 0.4 + 0.8*clamp((60.0-float(k))/40.0, 0.0, 1.0);
        float excite    = v * bassBoost;
        float rise      = 1.0 - exp(-100.0*tn);

        for( int j=ZERO; j<NMODES; j++ )
        {
            vec4 M    = bodyMode(j);
            float wbt = kTau*M.x*bt;
            float env = excite * rise * exp(-M.z*tn);
            modeS[j] += env * cos(wbt);
            modeC[j] += env * sin(wbt);
        }
    }

    vec2 bodyOut = vec2(0.0);
    for( int j=ZERO; j<NMODES; j++ )
    {
        vec4 M = bodyMode(j);
        float wt = kTau*M.x*t;
        float cL = cos(wt);
        float sL = sin(wt);
        float cR = cos(wt + M.w);
        float sR = sin(wt + M.w);
        float yL = sL*modeS[j] - cL*modeC[j];
        float yR = sR*modeS[j] - cR*modeC[j];
        bodyOut += M.y * vec2(yL, yR);
    }

    return strings + 0.08*bodyOut;
}

vec2 mainSound( in int samp, float time )
{
    vec2 y = play(time + 4.);
    return tanh(y*0.575)*0.5;
}

layout(location = 0) out vec4 outColor;

const ivec2 size = ivec2(4096,2048);

void main()
{
	ivec2 c = ivec2(gl_FragCoord.xy);
	int samp = c.x + c.y * size.x;
	float time = float(samp) / 44100.0;
    vec2 res = mainSound(samp, time);
	outColor = vec4(res, 0., 1.);
}